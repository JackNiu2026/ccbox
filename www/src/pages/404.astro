---
import '../styles/cage.css';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteIcons from '../components/SiteIcons.astro';
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#1b1917" />
  <GoogleAnalytics />
  <title>页面未找到 · CCBox</title>
  <SiteIcons />
</head>
<body>
  <SiteHeader />
  <main class="wrap not-found">
    <div class="page-intro dark-surface">
      <div>
        <h1>页面暂时找不到。</h1>
        <p>从 CCBox 首页继续查看下载和入门指南。</p>
        <div class="not-found-actions">
          <a class="button" href={base}>回到首页</a>
          <a class="text-link" href={base + 'docs/'}>使用文档 <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <span class="status-code" aria-hidden="true">404</span>
    </div>
  </main>
  <SiteFooter />
</body>
</html>
<style>
  body { display: flex; flex-direction: column; min-height: 100vh; }
  .not-found { margin-block: auto; padding-block: clamp(28px, 6vw, 84px); }
  .page-intro { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 20px 32px; }
  .not-found-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-block-start: 24px; }
  .not-found-actions .text-link { color: var(--accent); }
  .status-code { color: var(--accent); font-size: clamp(62px, 13vw, 168px); line-height: 0.9; font-weight: 650; letter-spacing: -0.04em; }
  @media (max-width: 700px) {
    .page-intro { grid-template-columns: minmax(0, 1fr); }
    .status-code { grid-row: 1; }
  }
</style>
