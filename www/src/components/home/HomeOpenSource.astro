---
import Icon from '../Icon.astro';
import type { HomeContext } from '../../lib/home';
interface Props { ctx: HomeContext }
const { base, copy: c } = Astro.props.ctx;
---
<section class="open-source wrap" aria-labelledby="license-title">
  <div class="open-source-license" data-reveal>
    <span class="icon-tile" aria-hidden="true"><Icon name="code" /></span>
    <h2 id="license-title"><a class="text-link" href={`${base}LICENSE.txt`}>{c.licenseTitle}</a></h2>
    <p>{c.licenseText}</p>
  </div>
  <div class="open-source-credits" data-reveal>
    <h3>{c.creditsTitle}</h3>
    {c.creditsIntro && <p class="credits-intro">{c.creditsIntro}</p>}
    <dl class="credits">
      {c.credits.map(({ name, text }) => <div><dt dir="ltr">{name}</dt><dd>{text}</dd></div>)}
    </dl>
  </div>
</section>
