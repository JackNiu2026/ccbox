---
interface Props {
  homeHref?: string;
  guideLabel?: string;
  privacyLabel?: string;
  note?: string;
}
const base = import.meta.env.BASE_URL;
const { homeHref = base, guideLabel = '使用文档', privacyLabel = '统计与隐私', note } = Astro.props;
---
<footer class="site-footer dark-surface">
  <div class="wrap site-footer-inner">
    <a class="brand" href={homeHref}>
      <img src={base + 'ccbox-icon.svg'} width="28" height="28" alt="" />
      <span>CCBox</span>
    </a>
    <div class="site-footer-links">
      <a href={base + 'docs/'}>{guideLabel}</a>
      <a href={base + 'privacy/'}>{privacyLabel}</a>
      <slot />
    </div>
    {note && <small>{note}</small>}
  </div>
</footer>
