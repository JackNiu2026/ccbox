---
import GoogleAnalytics from './GoogleAnalytics.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import SiteIcons from './SiteIcons.astro';
import '../styles/cage.css';
import '../styles/home-hero.css';
import '../styles/home-content.css';
import { cageCopy, languages, type CageLocale } from '../i18n/cage';
import { homeHero } from '../i18n/home-hero';
import releaseData from '../data/release.json';
import checks from '../../../assets/network-checks.png';
import browserChecks from '../../../assets/browser-checks.png';
interface Props { locale: CageLocale }
const { locale } = Astro.props;
const c = cageCopy[locale];
const hero = homeHero[locale];
const titleSeparator = c.lang.startsWith('zh-') ? '' : ' ';
const pageTitle = `ccBox — ${hero.lead}${titleSeparator}${hero.emphasis}`;
type PlatformRelease = { version: string; releaseURL?: string; downloadURL?: string };
type ReleaseMetadata = PlatformRelease & { windowsDownloadURL?: string; linuxDownloadURL?: string; androidDownloadURL?: string; windowsPreview?: PlatformRelease };
const stagedRelease = import.meta.glob<ReleaseMetadata>('../data/local-release.json', { eager: true, import: 'default' });
const published: ReleaseMetadata = stagedRelease['../data/local-release.json'] ?? releaseData;
for (const url of [published.releaseURL, published.downloadURL, published.windowsDownloadURL, published.linuxDownloadURL, published.androidDownloadURL, published.windowsPreview?.downloadURL, published.windowsPreview?.releaseURL]) {
  if (url && (!/^\/downloads\/[\w./-]+$/.test(url) || url.split("/").some(part => part === "." || part === ".."))) throw new Error("ccBox release links must point to local downloads.");
}
const base = import.meta.env.BASE_URL;
const guideLabels: Record<CageLocale, string> = {
  zh: '使用文档', 'zh-TW': '使用文件 · 中文', ru: 'Документация · 中文', ar: 'الدليل · 中文', fa: 'راهنما · 中文',
  ko: '사용 문서 · 中文', es: 'Documentación · 中文', my: 'လမ်းညွှန် · 中文', be: 'Дакументацыя · 中文',
  ps: 'لارښود · 中文', prs: 'راهنما · 中文', am: 'መመሪያ · 中文', so: 'Hagaha · 中文', ti: 'መምርሒ · 中文', fr: 'Documentation · 中文',
};
const guideLabel = guideLabels[locale];
const docHref = (slug: string) => base + 'docs/' + (slug === 'index' ? '' : slug + '/');
const platforms = [
  { name: 'macOS', icon: 'apple', requirements: 'Apple Silicon · macOS 14+', format: '.dmg',
    url: published.downloadURL, version: published.downloadURL ? published.version : undefined, notes: published.downloadURL ? published.releaseURL : undefined, guideURL: base + 'docs/installation/' },
  { name: 'Windows', icon: 'windows', requirements: 'Windows 10 22H2 / 11 · x64', format: '.exe',
    url: published.windowsDownloadURL || published.windowsPreview?.downloadURL,
    version: published.windowsDownloadURL ? published.version : published.windowsPreview?.version,
    preview: !published.windowsDownloadURL && !!published.windowsPreview,
    notes: published.windowsDownloadURL ? published.releaseURL : published.windowsPreview?.releaseURL, guideURL: base + 'docs/installation/' },
  { name: 'Linux', icon: 'linux', requirements: 'Debian 12 / Ubuntu 22.04 / 24.04 · x86_64', format: '.deb',
    url: published.linuxDownloadURL,
    version: published.linuxDownloadURL ? published.version : undefined,
    notes: published.linuxDownloadURL ? published.releaseURL : undefined, guideURL: base + 'docs/installation/' },
  { name: 'Android', icon: 'android', requirements: 'Android 8.0+ · arm64', format: '.apk',
    url: published.androidDownloadURL,
    version: published.androidDownloadURL ? published.version : undefined,
    notes: published.androidDownloadURL ? published.releaseURL : undefined, guideURL: `${base}docs/mobile/` },
  { name: 'iOS', icon: 'apple', requirements: 'iOS 17+ · Secure Enclave', localBuild: true,
    guideURL: `${base}docs/mobile/` },
];
const pathFor = (code: CageLocale) => `${base}${code === 'zh' ? '' : `${code}/`}`;
const desktopPlatforms = platforms.slice(0, 3);
const site = Astro.site;
const canonical = site && new URL(pathFor(locale), site);
---
<!doctype html>
<html lang={c.lang} dir={c.dir}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <GoogleAnalytics />
  <meta name="description" content={hero.description} />
  <meta name="theme-color" content="#1b1917" />
  <title>{pageTitle}</title>
  {canonical && <link rel="canonical" href={canonical} />}
  {site && languages.map(l => <link rel="alternate" hreflang={l.lang} href={new URL(pathFor(l.code), site)} />)}
  {site && <link rel="alternate" hreflang="x-default" href={new URL(base, site)} />}
  <SiteIcons />
  <meta property="og:type" content="website" /><meta property="og:site_name" content="ccBox" />
  <meta property="og:title" content={pageTitle} /><meta property="og:description" content={hero.description} />
  {canonical && <meta property="og:url" content={canonical} />}<meta property="og:image" content={site ? new URL(base + 'ccbox-icon.png', site) : base + 'ccbox-icon.png'} />
</head>
<body>
  <SiteHeader homeHref={pathFor(locale)} homeLabel={c.home}>
    <Fragment slot="links">
      <a class="nav-secondary" href={docHref('index')}>{guideLabel}</a>
      <a class="nav-secondary" href="#how">{c.start}</a>
      <a class="nav-download" href="#download" data-download-open aria-haspopup="dialog">{c.downloadLabel} <span aria-hidden="true">↓</span></a>
    </Fragment>
    <div class="language-switch">
      <span id="language-label">{c.languageLabel}</span>
      <details id="site-language" class="language-picker">
        <summary aria-labelledby="language-label current-language">
          <bdi id="current-language">{languages.find(l => l.code === locale)?.name}</bdi>
          <span class="language-chevron" aria-hidden="true"></span>
        </summary>
        <nav class="language-options" aria-labelledby="language-label">
          {languages.map(l => <a href={pathFor(l.code)} lang={l.lang} dir={l.dir} aria-current={l.code === locale ? 'page' : undefined}>{l.name}</a>)}
        </nav>
      </details>
    </div>
  </SiteHeader>
  <main id="main">
    <section class="story-hero" aria-labelledby="hero-title">
      <div class="hero-layout wrap">
        <div class="story-copy">
          <h1 id="hero-title">{hero.lead}{titleSeparator}<em>{hero.emphasis}</em></h1>
          <p class="hero-intro">{hero.description}</p>
          <div class="hero-actions">
            <a class="button" href="#download" data-download-open aria-haspopup="dialog">{c.downloadLabel} <span aria-hidden="true">↓</span></a>
            <a class="hero-guide" href={docHref('index')}>{guideLabel} <span aria-hidden="true">↗</span></a>
          </div>
          <ul class="hero-platforms" dir="ltr" role="list">
            {desktopPlatforms.map(({ name, icon }) => <li><img src={`${base}platforms/${icon}.svg`} width="16" height="16" alt="" />{name}</li>)}
          </ul>
        </div>
        <figure class="hero-preview">
          <div class="hero-preview-stage">
            <img src={`${base}workbench-preview.jpg`} width="1440" height="900" alt="ccBox" fetchpriority="high" />
          </div>
          <figcaption>ccBox · {c.uiPreviewLabel}</figcaption>
        </figure>
      </div>
    </section>
    <section class="manifesto wrap section-space">
      <div class="section-split">
        <h2>{c.why}</h2>
        <div>
          <p class="manifesto-intro">{c.whyText}</p>
          <ul class="key-features">{c.keyFeatures.map(text => <li>{text}</li>)}</ul>
        </div>
      </div>
    </section>
    <section class="tools section-space" aria-labelledby="tools-title">
      <div class="wrap">
        <div class="section-heading">
          <h2 id="tools-title">{c.featureTitle}</h2>
          <a class="text-link" href={docHref('index')}>{guideLabel} <span aria-hidden="true">↗</span></a>
        </div>
        <div class="tool-list">
          {c.features.map(({ title, text, guide }) =>
            <article>
              <h3>{title}</h3>
              <p>{text}</p>
              {guide && <a class="text-link" href={docHref(guide.slug)}>{guide.label} <span aria-hidden="true">↗</span></a>}
            </article>
          )}
        </div>
      </div>
    </section>
    <section class="evidence wrap section-space">
      <div class="section-heading">
        <h2>{c.checksLabel}</h2>
        <a class="text-link" href={docHref('network')}>{guideLabel} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="evidence-grid">
        {[{ image: checks, label: c.checksLabel }, { image: browserChecks, label: c.browserCheckLabel }].map(({ image, label }) =>
          <figure>
            <a href={image.src}><img src={image.src} width={image.width} height={image.height} alt={label} loading="lazy" /></a>
            <figcaption>{label} · {c.uiPreviewLabel}</figcaption>
          </figure>
        )}
      </div>
      <p class="small-note">{c.whyNote}</p>
    </section>
    <section id="how" class="start-section section-space dark-surface">
      <div class="wrap">
        <div class="section-split quick-start">
          <div><h2>{c.quickTitle}</h2><p>{c.quickText}</p></div>
          <div><pre><code>{c.prompt}</code></pre><p class="small-note">{c.quickNote}</p></div>
        </div>
        <h3 class="steps-title">{c.stepsTitle}</h3>
        <ol class="steps" role="list">
          {c.steps.map(([title, text], index) =>
            <li><span class="step-number" aria-hidden="true" dir="ltr">{index + 1}</span><h4>{title}</h4><p>{text}</p></li>
          )}
        </ol>
        <details class="first-look">
          <summary>{c.firstLookLabel}<span class="disclosure-chevron" aria-hidden="true"></span></summary>
          <img src={base + 'first-launch-preview.jpg'} width="1440" height="900" alt={c.firstLookLabel} loading="lazy" />
        </details>
      </div>
    </section>
    <section id="boundaries" class="boundaries wrap section-space section-split">
      <h2>{c.boundaryTitle}</h2>
      <ul class="boundary-list">{c.boundaries.map(([title, text]) => <li>{title && <strong>{title} </strong>}{text}</li>)}</ul>
    </section>
    <section id="download" class="download-section wrap">
      <div class="download-box dark-surface">
        <div class="download-content">
          <h2>{c.downloadTitle}</h2>
          <p>{c.downloadText}</p>
          <div class="download-actions">
            <a class="button" href="#download" data-download-open aria-haspopup="dialog">{c.downloadLabel} <span aria-hidden="true">↓</span></a>
            {published.releaseURL && <a class="text-link" href={published.releaseURL}>{c.releaseNotesLabel} ↗</a>}
          </div>
          <noscript><p class="download-fallback">{platforms.map(platform => <a class="text-link" href={platform.url || platform.guideURL}>{platform.name}{platform.localBuild ? ` · ${c.localBuildLabel}` : platform.preview ? ` · ${c.unsignedLabel}` : ''} ↗ </a>)}</p></noscript>
        </div>
        <div class="download-brand">
          <img src={`${base}ccbox-icon.svg`} width="84" height="84" alt="" />
          <span dir="ltr">ccBox · v{published.version}</span>
        </div>
        <div class="download-details">
          <ul class="download-meta" dir="ltr" role="list">{platforms.map(platform => <li>{platform.name}</li>)}</ul>
          <p class="access-note">{c.downloadNote}</p>
        </div>
      </div>
    </section>
    <section class="community-docs wrap section-space" aria-labelledby="docs-title">
      <div class="section-heading">
        <h2 id="docs-title">{c.docsTitle}</h2>
        <a class="text-link" href={docHref('index')}>{guideLabel} <span aria-hidden="true">↗</span></a>
      </div>
      <ul class="doc-links" role="list">
        {c.docs.map(doc => <li><a href={docHref(doc.slug)}>{doc.label}<span aria-hidden="true">↗</span></a><p>{doc.title}</p></li>)}
      </ul>
    </section>
    <section class="license wrap section-split"><h2>{c.licenseTitle}</h2><p>{c.licenseText}</p></section>
  </main>
  <SiteFooter homeHref={pathFor(locale)} guideLabel={guideLabel} privacyLabel={locale === 'zh' || locale === 'zh-TW' ? '统计与隐私' : 'Privacy'} note={c.independent} />
  <dialog class="download-dialog" aria-labelledby="platform-title">
    <div class="dialog-heading"><h2 id="platform-title">{c.platformLabel}</h2><form method="dialog"><button class="dialog-close" aria-label={c.closeLabel}>×</button></form></div>
    <div class="platform-options">{platforms.map(platform => <article class="platform-option" data-platform={platform.name}>
      <div class="platform-heading"><span class="platform-icon" aria-hidden="true"><img src={`${base}platforms/${platform.icon}.svg`} width="32" height="32" alt="" /></span><h3 dir="ltr">{platform.name}</h3></div><p class="platform-requirements" dir="ltr">{platform.requirements}</p>
      <p class="platform-status"><bdi>{platform.localBuild ? c.localBuildLabel : platform.preview ? c.unsignedLabel : platform.url ? platform.format : c.unavailableLabel}</bdi>{platform.version && <bdi dir="ltr"> · v{platform.version}</bdi>}</p>
      <a class="button" href={platform.url || platform.guideURL}>{platform.localBuild ? c.buildGuideLabel : platform.url ? c.downloadLabel : c.installGuideLabel} ↗</a>
      {platform.notes && <a class="text-link" href={platform.notes}>{c.releaseNotesLabel} ↗</a>}
      {platform.url && <a class="text-link" href={platform.guideURL}>{c.installGuideLabel} ↗</a>}
    </article>)}</div>
  </dialog>
  <script>
    const language = document.querySelector<HTMLDetailsElement>('#site-language');
    language?.addEventListener('keydown', event => {
      if (event.key === 'Escape' && language.open) {
        event.preventDefault();
        language.open = false;
        language.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', event => {
      if (language && event.target instanceof Node && !language.contains(event.target)) language.open = false;
    });
    const downloads = document.querySelector<HTMLDialogElement>('.download-dialog');
    document.querySelectorAll<HTMLAnchorElement>('[data-download-open]').forEach(link => {
      link.addEventListener('click', event => {
        if (!downloads) return;
        event.preventDefault();
        downloads.showModal();
      });
    });
    downloads?.addEventListener('click', event => {
      if (event.target !== downloads) return;
      const bounds = downloads.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) downloads.close();
    });
    const openDownloadHash = () => {
      if (window.location.hash === '#download' && downloads && !downloads.open) downloads.showModal();
    };
    window.addEventListener('hashchange', openDownloadHash);
    openDownloadHash();
  </script>
</body>
</html>
